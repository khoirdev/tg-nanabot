# Token bot Telegram
# Dapatkan dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Jenis API untuk menghasilkan gambar
# Nilai yang mungkin: placeholder, openai, stability, replicate, gemini, nanobanana
IMAGE_API_TYPE=nanobanana

# Kunci API untuk Gemini/Nano Banana (Google AI)
# Dukung multiple keys dengan pemisah koma (,)
# Contoh: GEMINI_API_KEY=key1,key2,key3
# Bot akan otomatis berpindah ke key berikutnya jika key saat ini error
GEMINI_API_KEY=your_gemini_api_key_here

# Kunci API untuk layanan lain (OpenAI, Stability, Replicate)
IMAGE_API_KEY=your_api_key_here
