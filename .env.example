# Токен Telegram бота
# Получить можно у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Тип API для генерации изображений
# Возможные значения: placeholder, openai, stability, replicate, gemini, nanobanana
IMAGE_API_TYPE=nanobanana

# API ключ для Gemini/Nano Banana (Google AI)
GEMINI_API_KEY=your_gemini_api_key_here

# API ключ для других сервисов (OpenAI, Stability, Replicate)
IMAGE_API_KEY=your_api_key_here
